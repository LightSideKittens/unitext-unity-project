  enter:
    rid: 2064119014248940504
  headline: Ship without shipping a single font.
  sub: The device already has them. UniText just asks.
  specimen: "Hello, world\n\u3053\u3093\u306B\u3061\u306F\u4E16\u754C \xB7 \uC548\uB155\uD558\uC138\uC694\n\u0645\u0631\u062D\u0628\u0627
    \u0628\u0627\u0644\u0639\u0627\u0644\u0645 \xB7 \u05E9\u05DC\u05D5\u05DD \u05E2\u05D5\u05DC\u05DD\n\u0393\u03B5\u03B9\u03AC
    \u03C3\u03BF\u03C5 \u039A\u03CC\u03C3\u03BC\u03B5 \xB7 \u10D2\u10D0\u10DB\u10D0\u10E0\u10EF\u10DD\u10D1\u10D0\n\u0928\u092E\u0938\u094D\u0924\u0947
    \u0926\u0941\u0928\u093F\u092F\u093E \xB7 \u0E2A\u0E27\u0E31\u0E2A\u0E14\u0E35\u0E0A\u0E32\u0E27\u0E42\u0E25\u0E01"
  references:
    version: 2
    RefIds:
    - rid: 2064119014248940504
      type: {class: Lift, ns: LightSide.Promo, asm: LightSide.Promo}
      data:
