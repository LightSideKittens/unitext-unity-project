  m_Name: 
  m_EditorClassIdentifier: LightSide.Promo::LightSide.Promo.TypographySlide
  seconds: 5
  pushIn: 0.035
  enter:
    rid: 2064119014248940184
  headline: Typography that finishes the job.
  sub: "Ruby, lists, small caps, superscript \u2014 every one a tag."
  body: "<ruby>\u6F22\u5B57<rt>\u304B\u3093\u3058</rt></ruby>\u306B<ruby>\u632F<rt>\u3075</rt></ruby>\u308A<ruby>\u4EEE\u540D<rt>\u304C\u306A</rt></ruby>\u3002\n\n<li>Ordered
    and nested lists</li>\n<li>Indents, paragraph spacing, line height</li>\n<li>Thai
    and Lao word breaking, with no spaces to go on</li>\n\n<smallcaps>Small caps</smallcaps>
    \xB7 H<sub>2</sub>O \xB7 x<sup>2</sup> \xB7 <upper>upper</upper>"
  bodySize: 50
  references:
    version: 2
    RefIds:
    - rid: 2064119014248940184
      type: {class: Push, ns: LightSide.Promo, asm: LightSide.Promo}
