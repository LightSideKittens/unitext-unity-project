    rid: 2064119014248939634
  headline: Yes, it sets mathematics.
  sub: "OpenType MATH \u2014 the same machinery TeX uses."
  mathFont: {fileID: 11400000, guid: 6ec2fbb4803b1254f8207b646dfb3383, type: 2}
  body: '<math>x = \frac{-b \pm \sqrt{b^2 - 4ac}}{2a}</math>    <math>e^{i\pi} +
    1 = 0</math>

    <math>\sum_{i=1}^{n} i = \frac{n(n+1)}{2}</math>    <math>\int_0^{\infty}
    e^{-x^2} dx = \frac{\sqrt{\pi}}{2}</math>'
  payoff: "Bars, radicals, script sizes and delimiters \u2014 all from the font."
  references:
    version: 2
    RefIds:
    - rid: 2064119014248939634
      type: {class: Push, ns: LightSide.Promo, asm: LightSide.Promo}
      data:
        seconds: 0.4
        direction: {x: -1, y: 0}
        travel: 1
        ease:
          kind: 1
          type: 0
          controls: {x: 0.2, y: 0, z: 0, w: 1}
          keys: []
          authoredControls: {x: 0.2, y: 0, z: 0, w: 1}
          authoredKeys: []
