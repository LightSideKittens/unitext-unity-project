.hub {
    --hub-accent: rgb(120, 175, 130);
    --hub-accent-hover: rgb(139, 194, 149);
    --hub-accent-soft: rgba(120, 175, 130, 0.14);
    --hub-accent-border: rgba(120, 175, 130, 0.55);
    --hub-info: rgb(115, 168, 224);
    --hub-warn: rgb(224, 178, 84);
    --hub-error: rgb(224, 108, 100);
    --hub-radius: 8px;
    --hub-control-radius: 6px;
    --hub-gap: 6px;
    --hub-pad: 14px;
    flex-grow: 1;
}

.hub--dark {
    --hub-page: rgb(40, 40, 40);
    --hub-surface: rgb(48, 48, 48);
    --hub-surface-hover: rgb(57, 57, 57);
    --hub-border: rgb(34, 34, 34);
    --hub-text: rgb(220, 222, 225);
    --hub-muted: rgba(220, 222, 225, 0.46);
    --hub-rail: rgb(44, 44, 44);
}

.hub--light {
    --hub-accent: rgb(57, 87, 63);
    --hub-accent-hover: rgb(48, 74, 53);
    --hub-accent-soft: rgba(57, 87, 63, 0.14);
    --hub-accent-border: rgba(57, 87, 63, 0.55);
    --hub-info: rgb(38, 96, 158);
    --hub-warn: rgb(140, 100, 20);
    --hub-error: rgb(160, 52, 46);
    --hub-page: rgb(200, 200, 200);
    --hub-surface: rgb(224, 224, 224);
    --hub-surface-hover: rgb(235, 235, 235);
    --hub-border: rgb(160, 160, 160);
    --hub-text: rgb(42, 44, 48);
    --hub-muted: rgba(42, 44, 48, 0.52);
    --hub-rail: rgb(210, 210, 210);
}

.hub__root {
    flex-grow: 1;
    background-color: var(--hub-page);
}

.hub__header {
    flex-direction: row;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: var(--hub-pad);
    padding-right: var(--hub-pad);
    border-bottom-width: 1px;
    border-bottom-color: var(--hub-border);
}

.hub__brand {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--hub-text);
}

.hub__brand-mark {
    width: 18px;
    height: 18px;
    margin-right: 8px;
    background-color: var(--hub-accent);
    border-radius: 5px;
}

.hub__spacer {
    flex-grow: 1;
}

.hub__body {
    flex-direction: row;
    flex-grow: 1;
}

.hub__rail {
    width: 172px;
    flex-shrink: 0;
    background-color: var(--hub-rail);
    border-right-width: 1px;
    border-right-color: var(--hub-border);
    padding-top: 8px;
}

.hub__rail-heading {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--hub-muted);
    margin-left: var(--hub-pad);
    margin-top: 10px;
    margin-bottom: 4px;
}

.hub__rail-item {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding-left: var(--hub-pad);
    padding-right: 10px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    margin: 0;
    color: var(--hub-text);
    -unity-text-align: middle-left;
}

.hub__rail-item:hover {
    background-color: var(--hub-surface-hover);
}

.hub__rail-item--selected {
    background-color: var(--hub-accent-soft);
    border-left-color: var(--hub-accent);
}

.hub__rail-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    margin-right: 8px;
    background-color: var(--hub-muted);
}

.hub__rail-dot--on {
    background-color: var(--hub-accent);
}

.hub__page {
    flex-grow: 1;
    padding-top: var(--hub-pad);
    padding-bottom: var(--hub-pad);
    padding-left: var(--hub-pad);
    padding-right: var(--hub-pad);
}

.hub__card {
    background-color: var(--hub-surface);
    border-radius: var(--hub-radius);
    border-width: 1px;
    border-color: var(--hub-border);
    padding-top: var(--hub-pad);
    padding-bottom: var(--hub-pad);
    padding-left: var(--hub-pad);
    padding-right: var(--hub-pad);
    margin-bottom: 10px;
}

.hub__title {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--hub-text);
    margin-bottom: 2px;
}

.hub__subtitle {
    font-size: 11px;
    color: var(--hub-muted);
    white-space: normal;
    margin-bottom: 8px;
}

.hub__text {
    color: var(--hub-text);
    white-space: normal;
}

.hub__muted {
    color: var(--hub-muted);
    font-size: 11px;
    white-space: normal;
}

.hub__row {
    flex-direction: row;
    align-items: center;
}

.hub__row > * {
    margin-right: var(--hub-gap);
}

.hub__row > *:last-child {
    margin-right: 0;
}

.hub__button {
    height: 26px;
    min-width: 84px;
    padding-left: 12px;
    padding-right: 12px;
    margin: 0;
    border-radius: var(--hub-control-radius);
    border-width: 1px;
    border-color: var(--hub-border);
    background-color: var(--hub-surface);
    color: var(--hub-text);
}

.hub__button:hover {
    background-color: var(--hub-surface-hover);
}

.hub__button:disabled {
    opacity: 0.45;
}

.hub__button--primary {
    background-color: var(--hub-accent);
    border-color: var(--hub-accent-border);
    color: rgb(28, 32, 29);
    -unity-font-style: bold;
}

.hub__button--primary:hover {
    background-color: var(--hub-accent-hover);
}

.hub__button--quiet {
    min-width: 0;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    color: var(--hub-muted);
}

.hub__button--quiet:hover {
    color: var(--hub-text);
    background-color: var(--hub-surface-hover);
}

.hub__field {
    margin: 0;
    flex-grow: 1;
}

.hub__field > .unity-base-text-field__input {
    height: 26px;
    border-radius: var(--hub-control-radius);
    border-width: 1px;
    border-color: var(--hub-border);
    background-color: var(--hub-page);
    color: var(--hub-text);
    padding-left: 8px;
}

.hub__field > .unity-base-text-field__input:focus {
    border-color: var(--hub-accent-border);
}

.hub__badge {
    font-size: 10px;
    -unity-font-style: bold;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 1px;
    padding-bottom: 1px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--hub-border);
    color: var(--hub-muted);
}

.hub__badge--on {
    color: var(--hub-accent);
    border-color: var(--hub-accent-border);
    background-color: var(--hub-accent-soft);
}

.hub__badge--info {
    color: var(--hub-info);
    border-color: var(--hub-info);
}

.hub__badge--warn {
    color: var(--hub-warn);
    border-color: var(--hub-warn);
}

.hub__status {
    margin-top: 8px;
    padding: 8px;
    border-radius: var(--hub-control-radius);
    border-left-width: 3px;
    background-color: var(--hub-page);
    color: var(--hub-text);
    white-space: normal;
}

.hub__status--info {
    border-left-color: var(--hub-info);
}

.hub__status--warn {
    border-left-color: var(--hub-warn);
}

.hub__status--error {
    border-left-color: var(--hub-error);
}

.hub__version-row {
    flex-direction: row;
    align-items: center;
    height: 34px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: var(--hub-control-radius);
}

.hub__version-row--installed {
    background-color: var(--hub-accent-soft);
}

.hub__version-name {
    color: var(--hub-text);
    -unity-font-style: bold;
    min-width: 110px;
}

.hub__separator {
    height: 1px;
    background-color: var(--hub-border);
    margin-top: 8px;
    margin-bottom: 8px;
}

.hub__empty {
    color: var(--hub-muted);
    -unity-text-align: middle-center;
    padding-top: 24px;
    padding-bottom: 24px;
    white-space: normal;
}
